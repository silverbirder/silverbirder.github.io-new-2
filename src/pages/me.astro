---
import Layout from '../layouts/Layout.astro';
import '../styles/site-page.css';
---

<Layout title="自己紹介" currentPage="me">
  <article class="site-page">
    <div class="profile">
      <h2 lang="en">silverbirder</h2>
      <p>Webソフトウェアエンジニア</p>
      <p>
        個人ブログキュレーション <a href="https://kobliy.vercel.app/about">こぶりー</a> 運営
      </p>
      <ul>
        <li>
          <a href="https://github.com/silverbirder">GitHub</a>
        </li>
        <li>
          <a href="https://x.com/silverbirder">X</a>
        </li>
        <li>
          <a href="https://bsky.app/profile/silverbirder.bsky.social">Bluesky</a>
        </li>
        <li>
          <a href="https://forms.gle/rWL2YyVjpcRRjusT9">問い合わせ</a>
        </li>
        <li>
          <a href="https://fequest.vercel.app/9">機能要望</a>
        </li>
      </ul>
    </div>
  </article>
</Layout>

<style>
  .profile {
    --profile-width: 30rem;

    max-inline-size: var(--profile-width);
    padding-block: var(--primitive-space-6);
    border-block-start: var(--semantic-border-width-hairline) solid
      var(--semantic-color-border-subtle);
    line-height: var(--semantic-line-height-body);
  }

  .profile h2 {
    margin: var(--primitive-space-none);
    font-size: var(--semantic-font-size-heading);
  }

  .profile p {
    margin-block: var(--primitive-space-2) var(--primitive-space-6);
  }
</style>
