---
import HomeWindow from '../layouts/HomeWindow.astro';
import Layout from '../layouts/Layout.astro';
import SiteWordmark from '../components/SiteWordmark.astro';

const base = import.meta.env.BASE_URL;
const title = 'ジブンノート';
const plushOutline =
  'M37.6 119 Q34.8 119.4 33.9 117.8 Q31.4 117.7 31.5 115.5 Q29.5 114.5 30.5 112.6 Q29.5 110.7 31 109.4 Q30.8 107.6 33 106.9 Q34.1 104.9 36.2 105 Q37.4 103.4 39.6 103.5 Q41 101.8 43.1 102 Q45.1 100.9 46 98.7 Q47 96.3 48.8 97 Q50 94.4 51.7 95.7 Q53.4 96.3 53.1 98.2 Q53.5 100.5 55.9 101.8 Q57.8 101.9 58.8 103.6 Q61.2 103.8 62.1 105.6 Q64.2 105.9 64.7 108 Q66.8 108.8 66.1 110.9 Q67.2 112.5 65.9 114.3 Q66.1 116.1 64.2 117 Q63.6 119 59.4 119';
const plushTexture =
  'M34.8 112.1 q.85 -1.1 1.7 0 M38.1 114.2 q.9 -1.1 1.8 -.15 M42 110.8 q.8 -1.1 1.6 -.3 M57 111 q.75 -1.05 1.6 .1 M59 114.3 q.95 -.9 1.7 .1';
---

<Layout {title} currentPage="home">
  <Fragment slot="head">
    <style is:inline>
      .home {
        --home-vertical-space: clamp(3.5rem, 9vh, 5.5rem);
        --home-gap: clamp(1.5rem, 4vw, 2.5rem);
        --home-nav-link-padding: 0.35em;
        --home-window-width: min(60vw, 22rem);
        --furniture-gap: clamp(0.5rem, 2.25vw, 2rem);
        --furniture-floor: calc(var(--home-vertical-space) + var(--home-window-width) * 1.25);
        --furniture-baseline-offset: 0 -100%;
        --room-edge: clamp(0.375rem, 1.3vw, 1rem);
        --room-spacing: clamp(0.25rem, 1.25vw, 1rem);
        /* Approximate dimensions in centimeters, scaled together beside the window. */
        --sofa-reference-width: 152;
        --desk-reference-width: 124;
        --display-shelf-reference-width: 50;
        --display-shelf-reference-height: 158;
        --furniture-side-width: max(
          var(--sofa-reference-width),
          var(--desk-reference-width) + var(--display-shelf-reference-width)
        );
        --furniture-side-space: calc(
          (100vw - var(--home-window-width)) / 2 - var(--furniture-gap) - var(--room-edge) -
            var(--room-spacing)
        );
        --furniture-unit: min(
          1.15px,
          calc(var(--furniture-side-space) / var(--furniture-side-width))
        );
        --desk-width: calc(var(--furniture-unit) * var(--desk-reference-width));
        --display-shelf-width: calc(var(--furniture-unit) * var(--display-shelf-reference-width));
        --sofa-width: calc(var(--furniture-unit) * var(--sofa-reference-width));
        --desk-left: calc((100% + var(--home-window-width)) / 2 + var(--furniture-gap));
        --display-shelf-left: calc(var(--desk-left) + var(--desk-width) + var(--room-spacing));
        --sofa-right: calc(var(--desk-left) + var(--room-spacing));

        position: relative;
        display: grid;
        justify-items: center;
        gap: var(--home-gap);
        padding: var(--home-vertical-space) var(--semantic-space-page-gutter);
        color: var(--semantic-color-text-primary);
        text-align: center;
      }

      .home-favorite-jacket {
        --jacket-width: calc(var(--furniture-unit) * 86);
        --sofa-back-height: calc(var(--furniture-unit) * 78);
        --jacket-collar-opacity: 0.34;
        --jacket-cuffs-opacity: 0.29;
        --jacket-texture-opacity: 0.72;

        inset-block-end: var(--sofa-back-height);
        justify-self: center;
        inline-size: var(--jacket-width);
      }

      .home-jacket-collar,
      .home-jacket-cuffs {
        fill: var(--semantic-color-text-link);
        stroke: none;
      }

      .home-jacket-collar {
        fill-opacity: var(--jacket-collar-opacity);
      }

      .home-jacket-cuffs {
        fill-opacity: var(--jacket-cuffs-opacity);
      }

      .home-jacket-texture {
        stroke-opacity: var(--jacket-texture-opacity);
      }

      .home-cuckoo-clock {
        --clock-width: calc(var(--furniture-unit) * 26);
        --clock-left: calc(
          var(--display-shelf-left) + (var(--display-shelf-width) - var(--clock-width)) / 2
        );
        --display-shelf-height: calc(var(--furniture-unit) * var(--display-shelf-reference-height));
        --clock-shelf-gap: calc(var(--furniture-unit) * 16);
        --clock-bottom: calc(
          var(--furniture-floor) - var(--display-shelf-height) - var(--clock-shelf-gap)
        );

        inset-block-start: var(--clock-bottom);
        inset-inline-start: var(--clock-left);
        inline-size: var(--clock-width);
      }

      .home-clock-pendulum {
        transform-box: fill-box;
        transform-origin: center top;
      }

      @property --clock-pendulum-phase {
        syntax: '<angle>';
        inherits: false;
        initial-value: 0deg;
      }

      @media (prefers-reduced-motion: no-preference) {
        .home-clock-pendulum {
          /* A seconds pendulum takes one second between turning points. */
          --pendulum-duration: 2s;
          --pendulum-amplitude: 10deg;

          rotate: calc(var(--pendulum-amplitude) * cos(var(--clock-pendulum-phase)));
          animation: home-clock-swing var(--pendulum-duration) linear infinite;
        }

        @keyframes home-clock-swing {
          to {
            --clock-pendulum-phase: 1turn;
          }
        }
      }

      .home-computer-desk {
        inset-inline-start: var(--desk-left);
        inline-size: var(--desk-width);
      }

      .home-shelf-boards {
        fill: var(--semantic-color-background-page);
      }

      .home-display-shelf {
        inset-inline-start: var(--display-shelf-left);
        inline-size: var(--display-shelf-width);
      }

      .home-room,
      .home-work-room {
        display: contents;
      }

      .home-living-room {
        display: grid;
        inset-inline-end: var(--sofa-right);
        inline-size: var(--sofa-width);
      }

      .home-sofa-drawing {
        --sofa-drawing-width: 100%;

        inline-size: var(--sofa-drawing-width);
        block-size: auto;
        overflow: visible;
      }

      .home-computer-desk,
      .home-display-shelf,
      .home-living-room {
        inset-block-start: var(--furniture-floor);
      }

      .home-cuckoo-clock,
      .home-computer-desk,
      .home-display-shelf,
      .home-living-room {
        translate: var(--furniture-baseline-offset);
      }

      .home-favorite-jacket,
      .home-cuckoo-clock,
      .home-computer-desk,
      .home-display-shelf,
      .home-living-room {
        position: absolute;
        block-size: auto;
        overflow: visible;
        fill: none;
        stroke: var(--semantic-color-text-link);
        stroke-width: var(--semantic-border-width-hairline);
        stroke-linecap: round;
        stroke-linejoin: round;
        pointer-events: none;
      }

      .home-cuckoo-clock :is(path, rect, circle),
      .home-computer-desk :is(path, rect),
      .home-display-shelf :is(path, rect, circle),
      .home-living-room path {
        vector-effect: non-scaling-stroke;
      }

      @media (max-width: 37.5rem) {
        .home {
          --furniture-unit: clamp(0.54px, 0.17vw, 0.7px);
          --mobile-room-height: calc(var(--furniture-unit) * 215);
          --mobile-room-gap: clamp(1rem, 6vw, 2.5rem);
        }

        .home-room {
          display: flex;
          align-items: end;
          min-block-size: var(--mobile-room-height);
          gap: var(--mobile-room-gap);
        }

        .home-living-room,
        .home-work-room {
          position: relative;
        }

        .home-living-room {
          inset: auto;
          translate: none;
        }

        .home-work-room {
          display: grid;
          grid-template-columns: var(--desk-width) var(--display-shelf-width);
          grid-template-areas: 'desk shelf';
          align-items: end;
          column-gap: var(--room-spacing);
        }

        .home-computer-desk,
        .home-display-shelf {
          position: static;
          translate: none;
        }

        .home-computer-desk {
          grid-area: desk;
        }

        .home-display-shelf {
          grid-area: shelf;
        }

        .home-cuckoo-clock {
          --clock-mobile-right: calc((var(--display-shelf-width) - var(--clock-width)) / 2);
          --clock-mobile-bottom: calc(var(--display-shelf-height) + var(--clock-shelf-gap));

          inset-block: auto var(--clock-mobile-bottom);
          inset-inline: auto var(--clock-mobile-right);
          translate: none;
        }
      }

      .home-intro h1 {
        --site-wordmark-size: clamp(2.5rem, 6vw, 3.5rem);

        margin: var(--primitive-space-none) auto;
      }

      .home-intro nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--primitive-space-6);
        margin-block-start: var(--primitive-space-6);
      }

      .home-intro nav a {
        padding-block: var(--home-nav-link-padding);
        border-block-end: var(--semantic-border-width-hairline) solid var(--semantic-color-accent);
        color: var(--semantic-color-text-link);
        text-decoration: none;
      }

      .home-intro nav a:hover {
        color: var(--semantic-color-accent);
      }
    </style>
  </Fragment>
