---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BlogArchive from '../../../components/BlogArchive.astro';
import { blogTagSlug, getTaggedBlogArchive } from '../../../lib/blog-articles';

export const getStaticPaths = (async () => {
  const tagged = await getTaggedBlogArchive();
  return [...tagged].map(([tag, entries]) => ({
    params: { tag: blogTagSlug(tag) },
    props: { tag, entries },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { tag, entries } = Astro.props;
---

<BlogArchive {tag} {entries} />
