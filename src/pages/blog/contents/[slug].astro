---
import Page from '../../../layouts/Page.astro';
import { posts } from '../../../lib/published.mjs';
export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
---
<Page title={`${post.title} | ジブンノート`} summary={post.summary} noindex={!post.index}>
  <article>
    <header>
      <h1>{post.title}</h1>
      <time datetime={post.publishedAt}>{new Date(post.publishedAt).toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' })}</time>
      {post.tags.length > 0 && <p>タグ: {post.tags.join('、')}</p>}
    </header>
    <div class="article-body" set:html={post.html} />
  </article>
</Page>
