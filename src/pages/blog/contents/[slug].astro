---
import { render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { articleSlug } from '../../../lib/article-slug';
import { getBlogArticles } from '../../../lib/blog-articles';
import { loadLinkCards } from '../../../lib/blog-link-card-source';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

const linkCardSnapshot = loadLinkCards();

export const getStaticPaths = (async () => {
  const articles = await getBlogArticles();
  articles.sort(
    (a, b) =>
      Date.parse(a.article.data.publishedAt) - Date.parse(b.article.data.publishedAt) ||
      a.article.id.localeCompare(b.article.id),
  );
  const existing = import.meta.glob('./*.md');
  const slugs = new Set(Object.keys(existing).map((path) => path.slice(2, -3)));
  return articles.flatMap(({ article, noindex, sharedFont }, index) => {
    const number = article.data.number ?? index + 1;
    const slug = articleSlug(article.id);
    if (slugs.has(slug)) throw new Error(`Multiple articles use the URL ${slug}`);
    slugs.add(slug);
    const legacy = article.data.draftId ? `cms-${article.data.draftId}` : undefined;
    const canonical = {
      params: { slug },
      props: { article, number, noindex, sharedFont, redirect: false },
    };
    if (!legacy || legacy === slug) return [canonical];
    if (slugs.has(legacy)) throw new Error(`Multiple articles use the URL ${legacy}`);
    slugs.add(legacy);
    return [
      canonical,
      {
        params: { slug: legacy },
        props: { ...canonical.props, redirect: true },
      },
    ];
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { article, number, noindex, sharedFont, redirect } = Astro.props;
if (redirect) {
  return Astro.redirect(
    `${import.meta.env.BASE_URL}blog/contents/${articleSlug(article.id)}/`,
    301,
  );
}
const { Content } = await render(article);
const linkCards = linkCardSnapshot.articles.get(article.id);
---

<ArticleLayout
  frontmatter={{ ...article.data, number }}
  {noindex}
  sharedFont={sharedFont}
  {linkCards}
>
  <Content />
</ArticleLayout>
