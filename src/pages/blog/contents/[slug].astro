---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { articleSlug } from '../../../lib/article-slug';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

export const getStaticPaths = (async () => {
  const articles = await getCollection('published');
  const existing = import.meta.glob('./*.md');
  const slugs = new Set(Object.keys(existing).map((path) => path.slice(2, -3)));
  return articles.flatMap((article) => {
    const slug = articleSlug(article.data.publishedAt);
    if (slugs.has(slug)) throw new Error(`Multiple articles use the date URL ${slug}`);
    slugs.add(slug);
    const previousId = article.data.draftId ?? article.id;
    return [
      { params: { slug }, props: { article } },
      { params: { slug: `cms-${previousId}` }, props: { article } },
    ];
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { article } = Astro.props;
if (Astro.params.slug?.startsWith('cms-')) {
  return Astro.redirect(
    `${import.meta.env.BASE_URL}blog/contents/${articleSlug(article.data.publishedAt)}/`,
    301,
  );
}
const { Content } = await render(article);
---

<ArticleLayout frontmatter={article.data}>
  <Content />
</ArticleLayout>
