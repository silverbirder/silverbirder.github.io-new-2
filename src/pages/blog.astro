---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { frontmatter, url } from './blog/contents/20261101.md';

const published = await getCollection('published');
const articles = [
  { url, title: frontmatter.title, publishedAt: frontmatter.publishedAt },
  ...published.map(({ id, data }) => ({
    url: `${import.meta.env.BASE_URL}blog/contents/cms-${id}/`,
    ...data,
  })),
].toSorted((a, b) => b.publishedAt.localeCompare(a.publishedAt));
---

<Layout title="ブログ" currentPage="blog">
  <h1>ブログ</h1>
  {articles.map((article) => (
    <p>
      <a href={article.url}>{article.title}</a>
    </p>
  ))}
</Layout>
