---
interface Props {
  months: string[];
}

const { months } = Astro.props;
const dates = months.map((month, index) => {
  const [year, number] = month.split('-');
  return {
    id: `month-${month}`,
    label: `${year}年${Number(number)}月`,
    year,
    startsYear: !months[index - 1]?.startsWith(year),
    ordinal: Number(year) * 12 + Number(number),
  };
});
const latestMonth = dates[0]?.ordinal ?? 0;
const slots = latestMonth - (dates.at(-1)?.ordinal ?? latestMonth) + 1;
---

{dates.length > 0 && (
  <dialog
    id="archive-month-dialog"
    class="month-dialog"
    closedby="any"
    aria-labelledby="archive-month-dialog-title"
  >
    <form method="dialog" class="month-dialog-header">
      <h2 id="archive-month-dialog-title">年月を選ぶ</h2>
      <button type="submit" aria-label="閉じる">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-width="0.6"
          aria-hidden="true"
        >
          <path d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
    </form>
    <div class="month-dialog-list">
      {[...Map.groupBy(dates, ({ year }) => year)].map(([year, group]) => (
        <section class="month-dialog-year" data-month-dialog-year>
          <h3>{year}年</h3>
          <ul>
            {group.map(({ id, label }) => (
              <li>
                <a
                  href={`#${id}`}
                  aria-label={label}
                  aria-current={id === dates[0].id ? 'location' : undefined}
                >
                  {label.slice(5)}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </dialog>
)}

{dates.length > 0 && (
  <nav class="month-nav" aria-label="年月で移動" data-month-nav>
    <ol class="month-nav-track" data-month-track={slots} style={`--month-slots: ${slots}`}>
      {dates.map(({ id, label, year, startsYear, ordinal }, index) => {
        const slot = latestMonth - ordinal + 1;
        return (
          <li style={`--month-slot: ${slot}`}>
            <a
              href={`#${id}`}
              aria-label={label}
              draggable="false"
              aria-current={index === 0 ? 'location' : undefined}
              class:list={['month-nav-link', { 'month-nav-year': startsYear }]}
              data-month-slot={slot}
            >
              <span class="month-nav-year-label" aria-hidden="true">
                {year}
              </span>
              <span class="month-nav-tick-hit" aria-hidden="true" />
              <span class="month-nav-tooltip" aria-hidden="true">
                {label}
              </span>
            </a>
          </li>
        );
      })}
    </ol>
  </nav>
)}

<style is:global>
  .month-nav {
    --month-track-length: min(21rem, 36svh);
    --month-tick-length: 0.3125rem;
    --month-year-tick-length: 0.625rem;
    --month-dot-size: 0.375rem;
    --month-dot-radius: calc(var(--month-dot-size) * var(--primitive-ratio-half));
    --month-label-center: calc(var(--primitive-size-full) * var(--primitive-ratio-half));
    --month-label-offset: calc(var(--month-label-center) * var(--primitive-scale-negative));
    --month-tooltip-gap: var(--primitive-space-2);
    --month-tooltip-layer: 1;

    font-size: var(--primitive-font-size-xs);
    font-variant-numeric: tabular-nums;
  }

  .month-nav-track {
    --month-slots: 1;
    --month-track-size: min(
      var(--month-track-length),
      calc(var(--month-slots) * var(--primitive-space-4))
    );

    display: grid;
    inline-size: max-content;
    grid-template-rows: repeat(var(--month-slots), minmax(var(--primitive-space-none), 1fr));
    block-size: var(--month-track-size);
    margin: var(--primitive-space-none);
    padding: var(--primitive-space-none);
    border-inline-start: var(--semantic-border-width-hairline) solid
      var(--semantic-color-border-paper);
    list-style: none;
    pointer-events: none;
    touch-action: none;
    user-select: none;
  }

  .month-nav-track > li {
    --month-slot: 1;

    grid-row: var(--month-slot);
  }

  .month-nav-link {
    position: relative;
    display: flex;
    align-items: center;
    block-size: var(--primitive-size-full);
    padding-inline-start: var(--primitive-space-4);
    color: var(--semantic-color-text-link);
    text-decoration: none;
  }

  .month-nav-link::before {
    position: absolute;
    inset-block-start: var(--month-label-center);
    inset-inline-start: var(--primitive-space-none);
    inline-size: var(--month-tick-length);
    block-size: var(--semantic-border-width-hairline);
    background: var(--semantic-color-border-paper);
    content: '';
  }

  .month-nav-year::before {
    inline-size: var(--month-year-tick-length);
    background: var(--semantic-color-text-link);
  }

  .month-nav-year-label,
  .month-nav-tooltip {
    line-height: var(--semantic-line-height-body);
    white-space: nowrap;
  }

  .month-nav :is(li[hidden], .month-nav-link:not(.month-nav-year) .month-nav-year-label),
  .month-dialog [hidden] {
    display: none;
  }

  .month-nav-year-label,
  .month-nav-tick-hit {
    pointer-events: auto;
  }

  .month-nav-tick-hit {
    position: absolute;
    inset-block: var(--primitive-space-none);
    inset-inline-start: calc(var(--month-dot-radius) * var(--primitive-scale-negative));
    inline-size: calc(var(--month-year-tick-length) + var(--month-dot-radius));
  }

  .month-nav-tooltip {
    position: absolute;
    inset-block-start: var(--month-label-center);
    inset-inline-start: calc(var(--primitive-size-full) + var(--month-tooltip-gap));
    transform: translateY(var(--month-label-offset));
    z-index: var(--month-tooltip-layer);
    display: none;
    padding-inline: var(--semantic-space-control-block);
    background: var(--semantic-color-text-link);
    color: var(--semantic-color-background-page);
    pointer-events: none;
  }

  @media (width >= 79rem) {
    .month-nav-tooltip {
      inset-inline: auto calc(var(--primitive-size-full) + var(--month-tooltip-gap));
    }
  }

  .month-nav-link:focus-visible > .month-nav-tooltip {
    display: block;
  }

  @media (hover: hover) {
    .month-nav-link:hover > .month-nav-tooltip {
      display: block;
    }
  }

  .month-nav-link:is(:hover, :focus-visible)::before,
  .month-nav-link[aria-current='location']::before {
    background: var(--semantic-color-accent);
  }

  .month-nav-track[data-tag-preview-active] .month-nav-link:not([data-tag-preview])::before,
  .month-nav-track[data-tag-preview-active]
    .month-nav-link:not([data-tag-preview])
    > .month-nav-tick-hit {
    visibility: hidden;
  }

  .month-nav-link[aria-current='location']::after {
    position: absolute;
    inset-block-start: calc(var(--month-label-center) - var(--month-dot-radius));
    inset-inline-start: calc(var(--semantic-border-width-hairline) - var(--month-dot-radius));
    inline-size: var(--month-dot-size);
    block-size: var(--month-dot-size);
    border-radius: var(--primitive-radius-full);
    background: var(--semantic-color-accent);
    pointer-events: none;
    content: '';
  }
  .month-dialog,
  .archive-find-dialog {
    --archive-dialog-width: 21rem;
    --archive-dialog-radius: 0.75rem;

    box-sizing: border-box;
    inline-size: min(
      var(--archive-dialog-width),
      calc(
        var(--primitive-size-full) - var(--semantic-space-page-gutter) *
          var(--primitive-ratio-double)
      )
    );
    padding: var(--semantic-space-control-inline);
    border: var(--semantic-border-width-hairline) solid var(--semantic-color-border-subtle);
    border-radius: var(--archive-dialog-radius);
    background: var(--semantic-color-background-page);
  }

  .month-dialog {
    --month-dialog-list-height: 58svh;
    --month-dialog-choice-size: 2.5rem;
  }

  .month-dialog :is(h2, h3, ul) {
    margin: var(--primitive-space-none);
  }

  .month-dialog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-block-end: var(--semantic-space-control-block);
  }

  .month-dialog h2 {
    font-size: var(--semantic-font-size-heading);
  }

  .month-dialog-list {
    max-block-size: var(--month-dialog-list-height);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .month-dialog-year {
    display: grid;
    grid-template-columns: auto minmax(var(--primitive-space-none), 1fr);
    gap: var(--semantic-space-control-block);
    padding-block: var(--semantic-space-control-block);
    border-block-start: var(--semantic-border-width-hairline) solid
      var(--semantic-color-border-subtle);
  }

  .month-dialog h3 {
    color: var(--semantic-color-accent);
    font-size: var(--semantic-font-size-label);
    line-height: var(--month-dialog-choice-size);
  }

  .month-dialog ul {
    display: flex;
    flex-wrap: wrap;
    padding: var(--primitive-space-none);
    list-style: none;
  }

  .month-dialog :is(button, a) {
    color: var(--semantic-color-text-link);
    font-size: var(--semantic-font-size-label);
  }

  .month-dialog button {
    display: grid;
    place-items: center;
    padding: var(--semantic-space-control-block);
    border: none;
    background: var(--semantic-color-background-page);
    cursor: pointer;
  }

  .month-dialog a {
    display: grid;
    place-items: center;
    inline-size: var(--month-dialog-choice-size);
    block-size: var(--month-dialog-choice-size);
    text-decoration: none;
  }

  .month-dialog a:is(:hover, :focus-visible, [aria-current='location']) {
    background: var(--semantic-color-background-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    :is(.month-dialog, .archive-find-dialog)[open] {
      --archive-dialog-start-offset: var(--primitive-space-2);
      --archive-dialog-duration: 180ms;

      animation: archive-dialog-open var(--archive-dialog-duration) ease-out;
    }

    @keyframes archive-dialog-open {
      from {
        opacity: var(--primitive-space-none);
        translate: var(--primitive-space-none) var(--archive-dialog-start-offset);
      }
    }
  }

  @media (width <= 48rem) {
    .month-nav {
      display: none;
    }
  }
</style>
