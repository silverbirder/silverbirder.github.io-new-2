---
import BlogActiveFilter from './BlogActiveFilter.astro';
import BlogFind from './BlogFind.astro';
import BlogMonthNav from './BlogMonthNav.astro';
import type { BlogArchiveEntry } from '../lib/blog-articles';
import Layout from '../layouts/Layout.astro';
import '../styles/site-page.css';

interface Props {
  entries: BlogArchiveEntry[];
  tag?: string;
}
const { entries, tag } = Astro.props;
const base = import.meta.env.BASE_URL;
const years = Map.groupBy(entries, ({ publishedAt }) => publishedAt.slice(0, 4));
const months = [...new Set(entries.map(({ publishedAt }) => publishedAt.slice(0, 7)))];
---

<Layout title={tag ? `${tag}の記事` : 'ブログ'} currentPage="blog">
  <div class="site-page blog-archive">
    {!tag && (
      <p class="archive-search-status" data-search-status data-site-base={base} role="status" />
    )}
    <div class="archive-actions">
      <BlogActiveFilter {tag} />
      {months.length > 0 && (
        <button
          class="archive-action archive-month-button"
          type="button"
          aria-label="年月で移動"
          aria-haspopup="dialog"
          aria-controls="archive-month-dialog"
          data-open-month-dialog
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-width="0.6"
            aria-hidden="true"
          >
            <path d="M3 10V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3Z" fill="currentColor" stroke="none" />
            <rect x="3" y="5" width="18" height="16" rx="2" />
            <path d="M7 3v4m10-4v4M3 10h18m-13 4h1m3 0h1m3 0h1m-9 3h1m3 0h1" />
          </svg>
        </button>
      )}
      <button
        class="archive-action"
        type="button"
        aria-label="記事を検索"
        aria-haspopup="dialog"
        aria-controls="archive-search-dialog"
        data-open-find-dialog
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="0.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="10" cy="10" r="7" />
          <path d="m15 15 6 6" />
        </svg>
      </button>
      <button
        class="archive-action"
        type="button"
        aria-label="タグ一覧"
        aria-haspopup="dialog"
        aria-controls="archive-tags-dialog"
        data-open-find-dialog
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="0.6"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 14 14 3h7v7L10 21Z" />
          <circle cx="16" cy="8" r="2" />
        </svg>
      </button>
    </div>
    <aside class="archive-sidebar" aria-label="記事を探す">
      <BlogFind {tag} />
    </aside>
    <div class="archive-month-navigation">
      <p class="archive-current-year" aria-hidden="true" data-archive-current-year>
        {months[0]?.slice(0, 4)}年
      </p>
      <BlogMonthNav months={months} />
    </div>
    <div class="archive-entries">
      {!tag && (
        <div
          class="archive-year archive-search-skeleton"
          data-search-skeleton
          hidden
          aria-hidden="true"
        >
          <div class="archive-year-header">
            <span class="archive-skeleton-bar archive-skeleton-year" />
          </div>
          <ul>
            {Array.from({ length: 6 }, () => (
              <li class="archive-entry">
                <div class="archive-skeleton-row">
                  <span class="archive-skeleton-bar archive-skeleton-date" />
                  <span class="archive-skeleton-bar archive-skeleton-title" />
                </div>
              </li>
            ))}
          </ul>
        </div>
      )}
      {[...years].map(([year, articles]) => (
        <section class="archive-year" aria-labelledby={`archive-${year}`}>
          <div class="archive-year-header">
            <h2 id={`archive-${year}`}>{year}年</h2>
          </div>
          <ul>
            {articles.map(({ url, title, publishedAt }, index) => {
              const month = publishedAt.slice(0, 7);
              const startsMonth = !articles[index - 1]?.publishedAt.startsWith(month);

              return (
                <li
                  class="archive-entry"
                  id={startsMonth ? `month-${month}` : undefined}
                  data-archive-month={month}
                >
                  <a class="archive-entry-link" href={url}>
                    <time datetime={publishedAt}>
                      {publishedAt.slice(5, 10).replace('-', ' / ')}
                    </time>
                    <span>{title}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
      {!tag && <div data-search-tail hidden aria-hidden="true"></div>}
    </div>
  </div>
</Layout>

<script src="../scripts/blog-search.ts"></script>

<style is:global>
  :root:has(.blog-archive) {
    --archive-content-width: 52rem;
    --archive-nav-width: 13rem;
    --archive-nav-gap: clamp(var(--semantic-space-control-block), 4vw, 3rem);
    --archive-layout-width: calc(
      var(--archive-content-width) + var(--archive-nav-gap) + var(--archive-nav-width)
    );
  }

  .site-page.blog-archive {
    --page-top-space: var(--semantic-space-control-inline);
    --archive-anchor-offset: 1.25rem;
    --archive-year-width: 6rem;
    --archive-articles-column: 2;
    --archive-sticky-top: calc(var(--component-site-header-offset) + var(--page-top-space));

    display: grid;
    isolation: isolate;
    grid-template-columns: minmax(var(--primitive-space-none), 1fr) var(--archive-nav-width);
    column-gap: var(--archive-nav-gap);
    grid-template-areas: 'intro sidebar' 'entries sidebar';
    grid-template-rows: auto minmax(var(--primitive-space-none), 1fr);
    max-inline-size: var(--archive-layout-width);
  }

  .archive-sidebar {
    --archive-sidebar-available-height: calc(
      100dvh - var(--archive-sticky-top) - var(--semantic-space-control-block)
    );

    position: sticky;
    inset-block-start: var(--archive-sticky-top);
    grid-area: sidebar;
    align-self: start;
    display: flex;
    flex-direction: column;
    justify-content: safe end;
    block-size: var(--archive-sidebar-available-height);
    gap: var(--semantic-space-control-block);
  }

  .archive-month-navigation {
    position: sticky;
    inset-block-start: var(--archive-sticky-top);
    grid-area: entries;
    align-self: start;
    justify-self: start;
    inline-size: var(--archive-year-width);
    z-index: var(--archive-month-layer);
    --archive-month-layer: 1;
  }

  :where(.archive-month-navigation:not(:has(> .month-nav:not([hidden])))) .archive-current-year {
    display: none;
  }

  .archive-current-year {
    margin-block-end: var(--semantic-space-control-inline);
    font-weight: var(--semantic-font-weight-heading);
  }

  .archive-actions {
    display: none;
  }

  .archive-entries {
    grid-area: entries;
  }

  .archive-entry {
    border-block-end: var(--semantic-border-width-hairline) solid
      var(--semantic-color-border-subtle);
    padding-block: var(--archive-row-spacing);
    scroll-margin-block-start: var(--archive-anchor-offset);
  }

  .archive-entry-link > span {
    overflow-wrap: anywhere;
  }

  .archive-year {
    --archive-date-width: 3.75rem;
    --archive-row-spacing: 0.75rem;
    --archive-year-spacing: 2.5rem;

    display: grid;
    grid-template-columns: var(--archive-year-width) minmax(var(--primitive-space-none), 1fr);
    gap: var(--semantic-space-control-inline);
    margin-block-end: var(--archive-year-spacing);
  }

  .archive-year-header {
    position: sticky;
    align-self: start;
    inset-block-start: calc(
      var(--component-site-header-offset) + var(--semantic-space-control-inline)
    );
    background-color: var(--semantic-color-background-page);
  }

  .archive-year h2,
  .archive-current-year {
    margin-block-start: var(--primitive-space-none);
    color: var(--semantic-color-accent);
    font-size: var(--semantic-font-size-heading);
    text-box: trim-start cap alphabetic;
  }

  @media (width > 48rem) {
    section.archive-year > .archive-year-header {
      position: absolute;
      clip-path: inset(var(--primitive-size-full));
    }

    .archive-year > ul {
      grid-column: var(--archive-articles-column);
    }
  }

  .archive-year h2 {
    margin-block-end: var(--primitive-space-none);
  }

  .archive-year > ul {
    margin: var(--primitive-space-none);
    padding: var(--primitive-space-none);
    border-block-start: var(--semantic-border-width-hairline) solid
      var(--semantic-color-border-subtle);
    list-style: none;
  }

  :is(.archive-entry-link, .archive-skeleton-row) {
    display: grid;
    grid-template-columns: var(--archive-date-width) minmax(var(--primitive-space-none), 1fr);
    gap: var(--archive-row-spacing);
    line-height: var(--semantic-line-height-body);
    text-decoration: none;
  }

  .archive-entry-link:is(:hover, :focus-visible) > span {
    text-decoration: underline var(--semantic-border-width-hairline);
  }

  .archive-year time {
    font-size: var(--semantic-font-size-label);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (48rem < width < 79rem) {
    .site-page.blog-archive {
      --archive-year-width: 9rem;
    }
  }

  @media (width <= 48rem) {
    .site-page.blog-archive,
    .archive-year {
      grid-template-columns: minmax(var(--primitive-space-none), 1fr);
      gap: var(--primitive-space-none);
    }

    .site-page.blog-archive {
      --page-top-space: var(--semantic-space-control-block);
      --archive-anchor-offset: 3rem;
      --archive-header-layer: 1;
      --archive-actions-layer: 2;
      --archive-calendar-button-size: 2.5rem;
      --archive-year-label-room: 5.25rem;

      grid-template-areas: 'intro' 'entries';
    }

    .archive-sidebar,
    .archive-month-navigation {
      display: contents;
    }

    .archive-current-year {
      display: none;
    }

    .archive-year-header,
    .archive-actions {
      inset-block-start: var(--component-site-header-offset);
      z-index: var(--archive-header-layer);
    }

    .archive-year-header {
      align-content: center;
      min-block-size: var(--archive-calendar-button-size);
      margin-inline: calc(
        var(--semantic-space-page-gutter) - var(--semantic-space-page-gutter) *
          var(--primitive-ratio-double)
      );
      padding: var(--primitive-space-none) var(--semantic-space-page-gutter);
    }

    .archive-year h2 {
      text-box: normal;
    }

    .archive-actions {
      grid-area: entries;
      position: sticky;
      z-index: var(--archive-actions-layer);
      align-self: start;
      justify-self: end;
      display: flex;
      max-inline-size: calc(var(--primitive-size-full) - var(--archive-year-label-room));
      background-color: var(--semantic-color-background-page);
    }

    .archive-action {
      flex: none;
      display: grid;
      place-items: center;
      inline-size: var(--archive-calendar-button-size);
      block-size: var(--archive-calendar-button-size);
      padding: var(--primitive-space-none);
      border: none;
      background: none;
      color: var(--semantic-color-text-link);
      cursor: pointer;
    }

    .archive-month-button[hidden] {
      display: none;
    }
  }

  .archive-search-skeleton {
    --skeleton-year-width: 4.5rem;
    --skeleton-title-width: 28ch;
    --skeleton-short-title-width: 18ch;
    --skeleton-bar-height: 0.625em;
  }

  .archive-skeleton-bar {
    display: block;
    align-self: center;
    inline-size: var(--primitive-size-full);
    block-size: var(--skeleton-bar-height);
    --skeleton-base-color-weight: 84%;

    border-radius: calc(var(--primitive-space-1) * var(--primitive-ratio-half));
    background: color-mix(
      in srgb,
      var(--semantic-color-border-subtle) var(--skeleton-base-color-weight),
      var(--semantic-color-text-link)
    );
  }

  .archive-skeleton-year {
    inline-size: var(--skeleton-year-width);
    font-size: var(--semantic-font-size-heading);
  }

  .archive-skeleton-date {
    inline-size: var(--primitive-space-8);
  }

  .archive-skeleton-title {
    max-inline-size: var(--skeleton-title-width);
  }

  .archive-search-skeleton li:nth-child(even) .archive-skeleton-title {
    max-inline-size: var(--skeleton-short-title-width);
  }

  .archive-skeleton-row {
    min-block-size: calc(var(--semantic-line-height-body) * var(--semantic-font-size-body));
  }

  .archive-search-status {
    grid-area: intro;
    margin: var(--primitive-space-none);
    margin-block-end: var(--semantic-space-control-block);
  }

  .archive-search-status:is(:empty, [data-announcement-only]) {
    position: absolute;
    inline-size: var(--primitive-size-css-pixel);
    block-size: var(--primitive-size-css-pixel);
    overflow: hidden;
    clip-path: inset(var(--primitive-size-full));
    white-space: nowrap;
  }

  .archive-year[hidden],
  .archive-year li[hidden] {
    display: none;
  }

  .archive-entries [data-search-tail] {
    min-block-size: var(--primitive-size-css-pixel);
  }
</style>
