---
import { blogTagHref } from '../lib/blog-articles';

interface Props {
  tags: readonly string[];
  activeTag?: string;
  tagMonths?: ReadonlyMap<string, string>;
  class?: string;
}

const { tags, activeTag, tagMonths, class: className } = Astro.props;
---

<ul class:list={['archive-find-tags', className]} aria-label="タグ">
  {tags.map((name) => {
    const active = activeTag === name;
    return (
      <li>
        <a
          href={active ? `${import.meta.env.BASE_URL}blog/` : blogTagHref(name)}
          data-active-tag={active || undefined}
          data-tag-months={tagMonths?.get(name)}
          aria-label={active ? `${name}の絞り込みを解除` : undefined}
        >
          <span>{name}</span>
        </a>
      </li>
    );
  })}
</ul>

<style is:global>
  .archive-find-tags {
    --archive-tag-min-size: 1.5rem;
    --archive-tag-font-size: 0.8125rem;
    --archive-tag-line-height: 1.4;
    --archive-tag-padding-block: 0.125rem;
    --archive-tag-point-width: 0.5rem;
    --archive-tag-hole-size: 0.5rem;
    --archive-tag-point-padding: 1.25rem;
    --archive-tag-edge: var(--primitive-size-css-pixel);
    --archive-tag-hole-shadow-blur: 0.125rem;
    --archive-tag-hole-shadow-opacity: 18%;
    --archive-tag-middle: calc(var(--primitive-size-full) * var(--primitive-ratio-half));

    display: flex;
    flex-wrap: wrap;
    gap: var(--primitive-space-1);
    margin: var(--primitive-space-none);
    padding: var(--primitive-space-none);
    list-style: none;
  }

  .archive-find-tags li {
    max-inline-size: var(--primitive-size-full);
    min-inline-size: var(--primitive-space-none);
  }

  .archive-find-tags a {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--archive-tag-min-size);
    max-inline-size: var(--primitive-size-full);
    min-block-size: var(--archive-tag-min-size);
    padding-block: var(--archive-tag-padding-block);
    padding-inline-start: var(--archive-tag-point-padding);
    padding-inline-end: var(--primitive-space-2);
    font-size: var(--archive-tag-font-size);
    line-height: var(--archive-tag-line-height);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .archive-find-tags a::before {
    --archive-tag-shoulder: calc(var(--primitive-size-full) - var(--archive-tag-point-width));
    --archive-tag-interior: calc(var(--primitive-size-full) - var(--archive-tag-edge));

    position: absolute;
    inset: var(--primitive-space-none);
    background-color: var(--semantic-color-border-subtle);
    clip-path: polygon(
      evenodd,
      var(--primitive-space-none) var(--primitive-space-none),
      var(--archive-tag-shoulder) var(--primitive-space-none),
      var(--primitive-size-full) var(--archive-tag-middle),
      var(--archive-tag-shoulder) var(--primitive-size-full),
      var(--primitive-space-none) var(--primitive-size-full),
      var(--primitive-space-none) var(--primitive-space-none),
      var(--archive-tag-edge) var(--archive-tag-edge),
      calc(var(--archive-tag-shoulder) - var(--archive-tag-edge)) var(--archive-tag-edge),
      var(--archive-tag-interior) var(--archive-tag-middle),
      calc(var(--archive-tag-shoulder) - var(--archive-tag-edge)) var(--archive-tag-interior),
      var(--archive-tag-edge) var(--archive-tag-interior),
      var(--archive-tag-edge) var(--archive-tag-edge)
    );
    transform: scaleX(var(--primitive-scale-negative));
    pointer-events: none;
    content: '';
  }

  .archive-find-tags a::after {
    --archive-tag-hole-shadow-color: hsl(
      var(--primitive-palette-slate-900-hue) var(--primitive-palette-slate-900-saturation)
        var(--primitive-palette-slate-900-lightness) / var(--archive-tag-hole-shadow-opacity)
    );

    position: absolute;
    inset-block: var(--primitive-space-none);
    inset-inline-start: var(--primitive-space-2);
    box-sizing: border-box;
    inline-size: var(--archive-tag-hole-size);
    block-size: var(--archive-tag-hole-size);
    margin-block: auto;
    border-radius: var(--primitive-size-full);
    background-color: var(--semantic-color-background-page);
    box-shadow:
      inset var(--primitive-space-none) var(--primitive-space-none) var(--primitive-space-none)
        var(--archive-tag-edge) var(--semantic-color-border-subtle),
      inset var(--primitive-space-none) var(--primitive-size-css-pixel)
        var(--archive-tag-hole-shadow-blur) var(--archive-tag-hole-shadow-color);
    pointer-events: none;
    content: '';
  }

  .archive-find-tags a > span {
    min-inline-size: var(--primitive-space-none);
  }

  .archive-find-tags a > span::before {
    position: absolute;
    inset: var(--primitive-space-none);
    z-index: var(--primitive-layer-decoration);
    background-image: linear-gradient(
      var(--semantic-color-background-muted),
      var(--semantic-color-background-muted)
    );
    background-repeat: no-repeat;
    background-size: var(--archive-tag-fill-size, var(--primitive-space-none))
      var(--primitive-size-full);
    clip-path: polygon(
      var(--primitive-space-none) var(--archive-tag-middle),
      var(--archive-tag-point-width) var(--primitive-space-none),
      var(--primitive-size-full) var(--primitive-space-none),
      var(--primitive-size-full) var(--primitive-size-full),
      var(--archive-tag-point-width) var(--primitive-size-full)
    );
    transition: background-size var(--component-archive-fill-duration) ease-out;
    pointer-events: none;
    content: '';
  }

  .archive-find-tags a:is(:active, :focus-visible, [data-active-tag]) {
    --archive-tag-fill-size: var(--primitive-size-full);
  }

  @media (hover: hover) {
    .archive-find-tags a:hover {
      --archive-tag-fill-size: var(--primitive-size-full);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .archive-find-tags a > span::before {
      transition: none;
    }
  }

  .archive-find-tags a[data-active-tag] {
    font-weight: var(--semantic-font-weight-heading);
  }
</style>
