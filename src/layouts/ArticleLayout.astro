---
import type { MarkdownLayoutProps } from 'astro';
import Layout from './Layout.astro';
import '../styles/article.css';

type Props = MarkdownLayoutProps<{ title: string; publishedAt: string }>;
const { frontmatter } = Astro.props;
const rule = `${import.meta.env.BASE_URL}notebook-rule.svg`;
---
<Layout title={frontmatter.title} currentPage="blog">
  <article class="notebook" style={`--notebook-rule: url("${rule}")`}>
    <header class="notebook-header">
      <h1>{frontmatter.title}</h1>
      <p><time datetime={frontmatter.publishedAt}>{frontmatter.publishedAt.slice(0, 10)}</time></p>
    </header>
    <div class="notebook-body"><slot /></div>
  </article>
</Layout>

<script>
  import '../scripts/notebook-selection';

  // Images and embeds can have arbitrary heights. Complete their last grid row.
  for (const body of document.querySelectorAll<HTMLElement>('.notebook-body')) {
    const observer = new ResizeObserver((entries) => {
      const unit = parseFloat(getComputedStyle(body).lineHeight);
      for (const entry of entries) {
        const extra = (unit - (entry.contentRect.height % unit)) % unit;
        (entry.target as HTMLElement).style.setProperty(
          '--rhythm-extra', `${extra < 0.05 || unit - extra < 0.05 ? 0 : extra}px`,
        );
      }
    });
    for (const child of body.children) {
      if (!child.hasAttribute('data-selection-layer')) observer.observe(child);
    }
  }
</script>
