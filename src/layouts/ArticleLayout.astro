---
import Layout from './Layout.astro';
import '../styles/tokens.css';
import '../styles/article.css';

type Props = {
  noindex?: boolean;
  sharedFont?: boolean;
  frontmatter: {
    title: string;
    publishedAt: string;
    number?: number;
    publicationId?: string;
    summary?: string | null;
  };
};
const { frontmatter, noindex, sharedFont } = Astro.props;
const ruleImage = `${import.meta.env.BASE_URL}notebook-rule.svg`;
const tickImage = `${import.meta.env.BASE_URL}notebook-ticks.svg`;
const [year, month, day] = frontmatter.publishedAt.slice(0, 10).split('-');
const dateLabel = `${year}年${Number(month)}月${Number(day)}日`;
---

<Layout
  title={frontmatter.title}
  description={frontmatter.summary}
  currentPage="blog"
  article
  {noindex}
  {sharedFont}
>
  <article
    class="notebook"
    data-publication-id={frontmatter.publicationId}
    style={`--notebook-rule-image: url("${ruleImage}"); --notebook-tick-image: url("${tickImage}")`}
  >
    <header class="notebook-header">
      <div class="notebook-meta">
        {frontmatter.number !== undefined && (
          <p class="notebook-entry notebook-number">
            <span class="notebook-entry-label notebook-meta-parts" lang="en">
              <span class="notebook-entry-text">NO</span>
              <span class="notebook-meta-dot" aria-hidden="true"></span>
            </span>
            <span class="notebook-entry-text">{frontmatter.number}</span>
          </p>
        )}
        <p class="notebook-entry">
          <span class="notebook-entry-label notebook-entry-text" lang="en">
            DATE
          </span>
          <time datetime={frontmatter.publishedAt}>
            <span class="visually-hidden">{dateLabel}</span>
            <span class="notebook-meta-parts" aria-hidden="true">
              <span class="notebook-entry-text">{year}</span>
              <span class="notebook-meta-dot" aria-hidden="true"></span>
              <span class="notebook-entry-text">{month}</span>
              <span class="notebook-meta-dot" aria-hidden="true"></span>
              <span class="notebook-entry-text">{day}</span>
            </span>
          </time>
        </p>
      </div>
      <div class="notebook-heading">
        <h1>{frontmatter.title}</h1>
      </div>
    </header>
    <div class="notebook-body">
      <slot />
    </div>
    <div class="notebook-bottom" aria-hidden="true"></div>
  </article>
</Layout>
