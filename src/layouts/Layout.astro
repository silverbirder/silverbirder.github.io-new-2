---
import 'kiso.css';
import '../../.astro/font-tokens.css';
import NotebookFonts from '../components/NotebookFonts.astro';

interface Props {
  title: string;
  currentPage: 'home' | 'blog';
  fontText?: string;
  fontBoldText?: string;
}
const { title, currentPage, fontText, fontBoldText } = Astro.props;
const base = import.meta.env.BASE_URL;
const characters = fontText ? [...new Set(`トップブログ${title}${fontText}`)].join('') : '';
const boldCharacters = [...new Set(`${title}${fontBoldText ?? fontText ?? ''}`)].join('');
const fontStylesheet = (weights: string, text = '') =>
  `https://fonts.googleapis.com/css2?family=Kaisei+Opti:wght@${weights}&display=swap${text ? `&text=${encodeURIComponent(text)}` : ''}`;
const fontUrls = characters ? [] : [fontStylesheet('400;700')];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <NotebookFonts text={characters} boldText={boldCharacters} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {fontText && <link rel="preconnect" href="https://res.cloudinary.com" />}
    {fontUrls.map((href) => (
      <link href={href} rel="stylesheet" />
    ))}
    <style is:global>
      body {
        font-family: var(--font-family-body);
        font-synthesis: none;
      }
    </style>
  </head>
  <body>
    <nav aria-label="メインナビゲーション">
      <a href={base} aria-current={currentPage === 'home' ? 'page' : undefined}>
        トップ
      </a>
      |
      <a href={`${base}blog/`} aria-current={currentPage === 'blog' ? 'page' : undefined}>
        ブログ
      </a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
