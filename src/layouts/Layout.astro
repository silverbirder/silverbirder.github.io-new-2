---
import '../styles/tokens.css';
import '../styles/link-icons.css';
import { addExternalLinkIcons } from '../lib/external-link-icons';
import SiteHeader from './SiteHeader.astro';

interface Props {
  title: string;
  description?: string | null;
  keywords?: string;
  currentPage: 'home' | 'blog' | 'me';
  article?: boolean;
  noindex?: boolean;
  sharedFont?: boolean;
}
const {
  title,
  description,
  keywords,
  currentPage,
  article = false,
  noindex,
  sharedFont,
} = Astro.props;
const summary = description?.trim();
const base = import.meta.env.BASE_URL;
const fontName = currentPage === 'home' ? 'home' : 'site';
const deferFont = sharedFont || (currentPage === 'blog' && !article);
const fontStylesheet = `${base}fonts/${fontName}.css`;
const content = addExternalLinkIcons(await Astro.slots.render('default'), Astro.url);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="only light" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {summary && <meta name="description" content={summary} />}
    {keywords && <meta name="keywords" content={keywords} />}
    {noindex && <meta name="robots" content="noindex" />}
    {deferFont ? (
      <>
        <link
          rel="stylesheet"
          href={fontStylesheet}
          media="print"
          onload="const showStyles=()=>requestAnimationFrame(()=>requestAnimationFrame(()=>this.setAttribute('media','all')));if(document.readyState==='complete')showStyles();else window.addEventListener('load',showStyles,{once:true})"
        />
        <noscript>
          <link rel="stylesheet" href={fontStylesheet} />
        </noscript>
      </>
    ) : (
      <link rel="stylesheet" href={fontStylesheet} />
    )}
    {article && <link rel="preconnect" href="https://res.cloudinary.com" />}
    <slot name="head" />
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }
    </style>
    <style is:global>
      @import 'kiso.css' layer(kiso);

      @layer kiso {
        /* 埋め込み先が書き換えるiframeの高さ属性を使う。 */
        :where([data-embed] iframe) {
          block-size: revert-layer;
        }
      }

      .notebook-body [data-embed] iframe {
        box-sizing: content-box;
        height: revert-layer;
      }

      :root {
        color-scheme: only light;
        background-color: var(--semantic-color-background-page);
      }

      :root:has(.site-header) {
        scroll-padding-block-start: var(--component-site-header-offset);
      }

      body {
        font-family: var(--semantic-font-family-body);
        font-synthesis: none;
      }
    </style>
  </head>
  <body>
    {currentPage !== 'home' && <SiteHeader />}
    <main>
      {
        // eslint-disable-next-line astro/no-set-html-directive -- Reuses the already-rendered Astro slot.
        <Fragment set:html={content} />
      }
    </main>
  </body>
</html>
