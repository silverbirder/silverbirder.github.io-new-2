---
import 'kiso.css';

interface Props {
  title: string;
  currentPage: 'home' | 'blog';
  fontText?: string;
}
const { title, currentPage, fontText } = Astro.props;
const base = import.meta.env.BASE_URL;
const characters = fontText ? [...new Set(`トップブログ${title}${fontText}`)].join('') : '';
const fontUrl = `https://fonts.googleapis.com/css2?family=Kaisei+Opti:wght@400;700&display=swap${characters ? `&text=${encodeURIComponent(characters)}` : ''}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {fontText && <link rel="preconnect" href="https://res.cloudinary.com" />}
    <link href={fontUrl} rel="stylesheet" />
    <style is:global>
      body {
        font-family: 'Kaisei Opti', serif;
        font-synthesis: none;
      }
    </style>
  </head>
  <body>
    <nav aria-label="メインナビゲーション">
      <a href={base} aria-current={currentPage === 'home' ? 'page' : undefined}>
        トップ
      </a>
      |
      <a href={`${base}blog/`} aria-current={currentPage === 'blog' ? 'page' : undefined}>
        ブログ
      </a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
