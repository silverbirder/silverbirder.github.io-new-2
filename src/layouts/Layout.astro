---
interface Props {
  title: string;
  currentPage: 'home' | 'blog';
}
const { title, currentPage } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <nav aria-label="メインナビゲーション">
      <a href={base} aria-current={currentPage === 'home' ? 'page' : undefined}>トップ</a>
      |
      <a href={`${base}blog/`} aria-current={currentPage === 'blog' ? 'page' : undefined}>ブログ</a>
    </nav>
    <main><slot /></main>
  </body>
</html>
