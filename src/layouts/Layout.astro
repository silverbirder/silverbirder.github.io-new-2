---
import 'kiso.css';
import '../styles/tokens.css';

interface Props {
  title: string;
  currentPage: 'home' | 'blog';
  article?: boolean;
}
const { title, currentPage, article = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const pagePath = Astro.url.pathname.slice(base.length).replace(/^\/|\/$/g, '');
const fontStylesheet = article
  ? `${base.replace(/\/$/, '')}/fonts/${pagePath}.css`
  : 'https://fonts.googleapis.com/css2?family=Kaisei+Opti:wght@400;700&display=swap';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="stylesheet" href={fontStylesheet} />
    {!article && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {article && <link rel="preconnect" href="https://res.cloudinary.com" />}
    <style is:global>
      body {
        font-family: var(--semantic-font-family-body);
        font-synthesis: none;
      }
    </style>
  </head>
  <body>
    <nav aria-label="メインナビゲーション">
      <a href={base} aria-current={currentPage === 'home' ? 'page' : undefined}>
        トップ
      </a>
      |
      <a href={`${base}blog/`} aria-current={currentPage === 'blog' ? 'page' : undefined}>
        ブログ
      </a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
