---
interface Props {
  title: string;
  currentPage: 'home' | 'blog';
}
const { title, currentPage } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <nav aria-label="メインナビゲーション">
      <a href="/" aria-current={currentPage === 'home' ? 'page' : undefined}>トップ</a>
      |
      <a href="/blog/" aria-current={currentPage === 'blog' ? 'page' : undefined}>ブログ</a>
    </nav>
    <main><slot /></main>
  </body>
</html>
