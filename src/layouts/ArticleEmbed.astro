---
import type { ArticleEmbed } from '../lib/insert-link-cards';

interface Props {
  embed: ArticleEmbed;
}
const { embed } = Astro.props;
const names = {
  bluesky: 'Bluesky',
  codepen: 'CodePen',
  instagram: 'Instagram',
  x: 'X',
  youtube: 'YouTube',
};
const title = names[embed.provider];
const playerStyles = {
  youtube:
    '--embed-rows: 10; --embed-columns: 18; max-width: calc(var(--component-notebook-rule-spacing) * var(--embed-columns)); height: calc(var(--component-notebook-rule-spacing) * var(--embed-rows)); margin-inline: auto;',
  codepen:
    '--embed-rows: 10; height: calc(var(--component-notebook-rule-spacing) * var(--embed-rows));',
};
---

{'src' in embed && (
  <>
    <div data-embed={embed.provider} style="margin-block-end: var(--primitive-space-none);">
      <iframe
        src={embed.src}
        title={`${title}の埋め込み`}
        loading="lazy"
        allow={
          embed.provider === 'youtube'
            ? 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
            : undefined
        }
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
        style={`display: block; width: var(--primitive-size-full); border: var(--primitive-space-none); ${playerStyles[embed.provider]}`}
      />
    </div>
    <p>
      <a href={embed.url}>{title}で開く</a>
    </p>
  </>
)}
{embed.provider === 'x' && (
  <div
    data-embed={embed.provider}
    data-x-post={embed.url.split('/').at(-1)}
    style="display: flow-root;"
  >
    <p data-x-fallback>
      <a href={embed.url}>Xで投稿を開く</a>
    </p>
    <template>
      <section style="--x-card-width: 550px; max-width: var(--x-card-width); margin-inline: auto; padding: var(--primitive-space-4); overflow-wrap: anywhere; background: var(--semantic-color-background-page); border: var(--semantic-border-width-hairline) solid var(--semantic-color-border-paper);">
        <a href={embed.url} aria-label="Xで投稿を開く">
          <strong data-x-author></strong>
          <span data-x-handle></span>
        </a>
        <p data-x-text style="white-space: pre-wrap;"></p>
        <div data-x-media></div>
        <time data-x-date></time>
      </section>
    </template>
  </div>
)}
{embed.provider === 'instagram' && (
  <div data-embed={embed.provider} style="display: flow-root;">
    <blockquote
      class="instagram-media"
      data-instgrm-permalink={embed.url}
      data-instgrm-version="14"
      data-instgrm-captioned
      style="margin: var(--primitive-space-none); min-width: var(--primitive-space-none); max-width: var(--primitive-size-full);"
    >
      <p>
        <a href={embed.url}>Instagramで投稿を開く</a>
      </p>
    </blockquote>
  </div>
)}
{embed.provider === 'bluesky' && (
  <div data-embed={embed.provider} style="display: flow-root;">
    <p data-bluesky-actor={embed.actor} data-bluesky-record={embed.record}>
      <a href={embed.url}>Blueskyで投稿を開く</a>
    </p>
  </div>
)}

<script src="../scripts/bluesky-embeds.mts"></script>
<script src="../scripts/x-embeds.mts"></script>
<script src="../scripts/instagram-embeds.mts"></script>
