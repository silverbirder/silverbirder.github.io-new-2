---
import type { ArticleEmbed } from '../lib/insert-link-cards';

interface Props {
  embed: ArticleEmbed;
}
const { embed } = Astro.props;
const names = {
  bluesky: 'Bluesky',
  codepen: 'CodePen',
  instagram: 'Instagram',
  x: 'X',
  youtube: 'YouTube',
};
const title = names[embed.provider];
---

{'src' in embed && (
  <div class="embed-player" data-embed={embed.provider}>
    <iframe
      src={embed.src}
      title={`${title}の埋め込み`}
      loading="lazy"
      allow={
        embed.provider === 'youtube'
          ? 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
          : undefined
      }
      allowfullscreen
      referrerpolicy="strict-origin-when-cross-origin"
    />
    <p class="embed-source">
      <a href={embed.url}>{title}で開く</a>
    </p>
  </div>
)}
{embed.provider === 'x' && (
  <div
    data-embed={embed.provider}
    data-x-post={embed.url.split('/').at(-1)}
    style="display: flow-root;"
  >
    <p class="embed-source" data-x-fallback>
      <a href={embed.url}>Xで投稿を開く</a>
    </p>
    <template>
      <section class="x-post-card">
        <a class="x-post-source" href={embed.url} aria-label="Xで投稿を開く">
          <span class="x-post-author">
            <strong data-x-author></strong>
            <span data-x-handle></span>
          </span>
          <span class="x-post-source-mark" aria-hidden="true">
            X
          </span>
        </a>
        <p data-x-text style="white-space: pre-wrap;"></p>
        <div data-x-media></div>
        <time data-x-date></time>
      </section>
    </template>
  </div>
)}
{embed.provider === 'instagram' && (
  <div data-embed={embed.provider} style="display: flow-root;">
    <blockquote
      class="instagram-media"
      data-instgrm-permalink={embed.url}
      data-instgrm-version="14"
      data-instgrm-captioned
      style="margin: var(--primitive-space-none); min-width: var(--primitive-space-none); max-width: var(--primitive-size-full);"
    >
      <p class="embed-source">
        <a href={embed.url}>Instagramで投稿を開く</a>
      </p>
    </blockquote>
  </div>
)}
{embed.provider === 'bluesky' && (
  <div data-embed={embed.provider} style="display: flow-root;">
    <p class="embed-source" data-bluesky-actor={embed.actor} data-bluesky-record={embed.record}>
      <a href={embed.url}>Blueskyで投稿を開く</a>
    </p>
  </div>
)}

<script src="../scripts/bluesky-embeds.mts"></script>
<script src="../scripts/x-embeds.mts"></script>
<script src="../scripts/instagram-embeds.mts"></script>

<style>
  .embed-player {
    --embed-rows: 10;

    margin-inline: auto;
  }

  .embed-player[data-embed='youtube'] {
    --embed-columns: 18;

    max-inline-size: calc(var(--component-notebook-rule-spacing) * var(--embed-columns));
  }

  .embed-player > iframe {
    display: block;
    inline-size: var(--primitive-size-full);
    block-size: calc(var(--component-notebook-rule-spacing) * var(--embed-rows));
    border: var(--primitive-space-none);
  }

  .embed-source {
    text-align: end;
  }

  [data-embed='x'] {
    --x-card-width: 550px;
  }

  [data-x-fallback] {
    max-inline-size: var(--x-card-width);
    margin-inline: auto;
  }

  [data-bluesky-actor] {
    --bluesky-fallback-width: 600px;

    max-inline-size: var(--bluesky-fallback-width);
    margin-inline: auto;
  }

  .x-post-card {
    max-inline-size: var(--x-card-width);
    margin-inline: auto;
    padding: var(--primitive-space-4);
    border: var(--semantic-border-width-hairline) solid var(--semantic-color-text-link);
    border-radius: var(--primitive-space-2);
    background: var(--semantic-color-background-page);
    overflow-wrap: anywhere;
  }

  .x-post-source {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--primitive-space-2);
    text-decoration: none;
  }

  .x-post-source:is(:hover, :focus-visible) .x-post-author {
    text-decoration: underline var(--semantic-border-width-hairline);
  }

  .x-post-source-mark {
    flex: none;
    color: var(--semantic-color-text-primary);
    font-weight: var(--semantic-font-weight-heading);
  }
</style>
