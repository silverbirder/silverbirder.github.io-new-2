---
import type { BlogLinkCard } from '../lib/blog-link-card-source';

type Props = { card: BlogLinkCard };
const { card } = Astro.props;
const thumbnail = card.image && import.meta.env.BASE_URL + 'link-card/' + card.image + '.webp';
---

<div class="link-card-block">
  <a class="link-card" href={card.url}>
    <span class="link-card-tape" aria-hidden="true"></span>
    <span class="link-card-holes" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
    <span class="link-card-copy">
      <strong class="link-card-title">{card.title}</strong>
      {card.description && <span class="link-card-description">{card.description}</span>}
      <span class="link-card-domain">{card.domain}</span>
    </span>
    {thumbnail && (
      <img
        class="link-card-image"
        src={thumbnail}
        alt=""
        width="160"
        height="90"
        loading="lazy"
        decoding="async"
      />
    )}
  </a>
</div>

<style>
  .link-card-block {
    padding-block-start: var(--primitive-space-2);
  }

  .link-card {
    --paper-lightness: 96%;
    --paper-clear: transparent;
    --paper-tint: hsl(
      var(--primitive-palette-blue-200-hue) var(--primitive-palette-blue-200-saturation)
        var(--paper-lightness)
    );
    --card-padding: 0.8rem;
    --hole-size: 11px;
    --hole-inset: 0.27rem;
    --margin-line-inset: 1.42rem;
    --hole-column: var(--primitive-space-8);
    --shadow-x: 1px;
    --shadow-y: 1.5px;
    --shadow-blur: 2px;
    --shadow-color: hsl(
      var(--primitive-palette-blue-700-hue) var(--primitive-palette-blue-700-saturation)
        var(--primitive-palette-blue-700-lightness) / var(--primitive-opacity-35)
    );
    --tape-width: 3.6rem;
    --tape-height: 0.95rem;
    --tape-angle: -6deg;
    --tape-pattern-angle: 135deg;
    --tape-band-width: 3px;
    --tape-band-lightness: 66%;
    --tape-band: hsl(
      var(--primitive-palette-sage-hue) var(--primitive-palette-sage-saturation)
        var(--tape-band-lightness) / var(--primitive-opacity-70)
    );
    --tape-edge: polygon(
      0 0,
      100% 0,
      95% 24%,
      100% 48%,
      96% 75%,
      100% 100%,
      0 100%,
      5% 76%,
      0 50%,
      4% 24%
    );
    --card-line-height: 1.45;
    --card-line-limit: 2;
    --thumbnail-fraction: 25%;
    --thumbnail-width: 10rem;
    --thumbnail-ratio: 16 / 9;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--primitive-space-2);
    padding: var(--card-padding) var(--card-padding) var(--card-padding) var(--hole-column);
    background:
      linear-gradient(
        to right,
        var(--paper-clear) var(--margin-line-inset),
        var(--semantic-color-border-subtle) var(--margin-line-inset)
          calc(var(--margin-line-inset) + var(--semantic-border-width-hairline)),
        var(--paper-clear) calc(var(--margin-line-inset) + var(--semantic-border-width-hairline))
      ),
      var(--paper-tint);
    box-shadow: var(--shadow-x) var(--shadow-x) var(--shadow-blur)
      var(--semantic-color-border-subtle);
    line-height: var(--card-line-height);
    color: var(--semantic-color-text-primary);
    text-decoration: none;
  }

  .link-card:focus-visible {
    outline: var(--primitive-size-css-pixel) solid var(--semantic-color-text-link);
    outline-offset: var(--primitive-space-1);
  }

  .link-card-tape,
  .link-card-holes {
    position: absolute;
    pointer-events: none;
  }

  .link-card-tape {
    inset-block-start: calc(
      var(--tape-height) * var(--primitive-ratio-half) * var(--primitive-layer-decoration)
    );
    inset-inline-start: calc(
      (var(--primitive-size-full) - var(--tape-width)) * var(--primitive-ratio-half)
    );
    inline-size: var(--tape-width);
    block-size: var(--tape-height);
    background: repeating-linear-gradient(
      var(--tape-pattern-angle),
      var(--tape-band) var(--primitive-space-none) var(--tape-band-width),
      var(--semantic-color-background-selection) var(--tape-band-width)
        calc(var(--tape-band-width) * var(--primitive-ratio-double))
    );
    transform: rotate(var(--tape-angle));
    clip-path: var(--tape-edge);
  }

  .link-card-holes {
    inset-block: var(--primitive-space-1);
    inset-inline-start: var(--hole-inset);
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
  }

  .link-card-holes > span {
    inline-size: var(--hole-size);
    block-size: var(--hole-size);
    border-radius: var(--primitive-radius-full);
    background: var(--semantic-color-background-page);
    box-shadow: inset var(--shadow-x) var(--shadow-y) var(--shadow-blur) var(--shadow-color);
  }

  .link-card-copy {
    display: grid;
    gap: var(--primitive-space-1);
    min-inline-size: var(--primitive-space-none);
  }

  .link-card-title,
  .link-card-description {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--card-line-limit);
  }

  .link-card:hover .link-card-title {
    text-decoration: underline var(--semantic-border-width-hairline);
  }

  .link-card-description,
  .link-card-domain {
    font-size: var(--semantic-font-size-label);
  }

  .link-card-domain {
    color: var(--semantic-color-text-link);
  }

  .link-card-image {
    flex: none;
    inline-size: min(var(--thumbnail-fraction), var(--thumbnail-width));
    block-size: auto;
    height: auto;
    aspect-ratio: var(--thumbnail-ratio);
    object-fit: cover;
    object-position: center;
  }
</style>
