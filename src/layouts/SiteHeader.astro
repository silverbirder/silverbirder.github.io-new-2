---
const base = import.meta.env.BASE_URL;
const me = `${base}me/`;
const blog = `${base}blog/`;
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="site-logo" href={base}>
      <img src={`${base}jibun-note-logo.png`} width="1129" height="181" alt="ジブンノート トップ" />
    </a>
    <nav aria-label="メインナビゲーション">
      <a href={me} aria-current={path === me ? 'page' : undefined}>
        自己紹介
      </a>
      <a href={blog} aria-current={path === blog ? 'page' : undefined}>
        ブログ
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    --site-header-layer: 2;

    position: sticky;
    inset-block-start: var(--primitive-space-none);
    z-index: var(--site-header-layer);
    --site-header-border-color: transparent;

    /* 境界線の領域をブラウザのピクセル丸めに合わせる。 */
    border-block-end: var(--semantic-border-width-hairline) solid var(--site-header-border-color);
    background: var(--semantic-color-background-page);
  }

  .site-header-inner {
    --header-width: 60rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--semantic-space-control-inline);
    max-inline-size: var(--header-width);
    min-block-size: var(--component-site-header-height);
    margin-inline: auto;
    padding-inline: var(--semantic-space-page-gutter);
  }

  .site-logo {
    --logo-width: 9rem;

    flex: auto;
    max-inline-size: var(--logo-width);
    min-inline-size: var(--primitive-space-none);
  }

  .site-logo img {
    display: block;
    inline-size: var(--primitive-size-full);
    block-size: auto;
  }

  nav {
    display: flex;
    flex: none;
    gap: var(--semantic-space-page-gutter);
    font-size: var(--semantic-font-size-label);
  }

  nav a {
    padding-block: var(--semantic-space-control-block);
    color: var(--semantic-color-text-link);
    text-decoration: none;
    text-underline-offset: var(--semantic-text-link-underline-offset);
  }

  nav a:hover:not([aria-current='page']) {
    text-decoration: underline var(--semantic-border-width-hairline);
  }

  nav a[aria-current='page'] {
    font-weight: var(--semantic-font-weight-heading);
  }
</style>
