{
  "name": "silverbirder-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --import ./scripts/environment.mjs ./node_modules/astro/bin/astro.mjs dev --host 127.0.0.1",
    "build": "node --import ./scripts/environment.mjs ./node_modules/astro/bin/astro.mjs build",
    "preview": "node --import ./scripts/environment.mjs ./node_modules/astro/bin/astro.mjs preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "astro": "7.4.11",
    "gray-matter": "4.0.3",
    "js-yaml": "5.5.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0"
  }
}
