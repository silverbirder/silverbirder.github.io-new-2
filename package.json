{
  "name": "silverbirder-blog-preview",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "lint:js": "oxlint . --deny-warnings",
    "lint:astro": "eslint \"src/**/*.astro\"",
    "format:check": "oxfmt --check .",
    "format": "oxfmt --write .",
    "prepare": "husky",
    "check": "node scripts/check.mjs",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "lint:md": "markdownlint-cli2",
    "lint:config": "npm run lint:package && npm run lint:registry && actionlint && sh -n .husky/pre-commit",
    "lint:package": "npmPkgJsonLint . --ignorePath .gitignore --maxWarnings 0 && npm ci --dry-run --ignore-scripts --no-audit --no-fund",
    "lint:registry": "npm config list --json --location=project | jq -e '.registry == \"https://npm.flatt.tech/\" and .[\"min-release-age\"] == 7 and .[\"engine-strict\"] == true and .[\"save-exact\"] == true'",
    "typecheck": "astro check",
    "test": "node --test scripts/*.test.mjs",
    "lint:unused": "knip",
    "lint:duplicates": "jscpd",
    "audit": "npm audit",
    "lint:html": "html-validate \"dist/**/*.html\"",
    "check:assets": "size-limit --ignore-missing && npm run lint:unused-css",
    "lint:unused-css": "mkdir -p .cache/quality && purgecss --css 'src/styles/*.css' --content 'dist/**/*.html' --safelist h1 h2 h3 h4 h5 h6 p a ul ol li blockquote pre code hr table thead tbody tr th td figure figcaption img video iframe --rejected > .cache/quality/purgecss.json && jq -e 'length > 0 and all(.[]; (.rejected | length) == 0)' .cache/quality/purgecss.json",
    "check:browser": "node scripts/check-render.mjs",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/playwright playwright install chromium"
  },
  "dependencies": {
    "astro": "7.4.7",
    "kiso.css": "1.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler-rs": "0.5.2",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@size-limit/file": "14.3.0",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "html-validate": "11.19.0",
    "husky": "9.1.7",
    "jscpd": "5.4.3",
    "knip": "6.44.2",
    "lighthouse": "13.6.0",
    "markdownlint-cli2": "0.24.0",
    "npm-package-json-lint": "11.0.1",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "postcss-html": "2.0.0",
    "purgecss": "9.1.0",
    "size-limit": "14.3.0",
    "stylelint": "18.0.0",
    "stylelint-config-recommended": "19.0.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "eslint-plugin-jsx-a11y-x": {
      "minimatch": "^11.0.1"
    },
    "eslint-plugin-sonarjs": {
      "minimatch": "^11.0.1"
    },
    "markdownlint": {
      "re2js": "^2.8.7"
    },
    "micromark-extension-math": {
      "katex": "^0.18.2"
    }
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.15.0"
  }
}
